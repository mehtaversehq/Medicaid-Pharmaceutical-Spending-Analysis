      <column caption='Date' datatype='date' name='[Calculation_3202051658465280]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(INT([Year]), (INT([Quarter])*3)-2, 1)' />
      </column>
      <column caption='Reimbursement Per Capita' datatype='real' name='[Calculation_3202051673829377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Amount Reimbursed]) / SUM([2024 Population])' />
      </column>
      <column caption='Medicaid Reimbursement per Capita' datatype='real' name='[Calculation_3202051701055490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Medicaid Amount Reimbursed])/SUM([2024 Population])' />
      </column>
      <column caption='Non-Medicaid Reimbursement per Capita' datatype='real' name='[Calculation_3202051701321731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Non Medicaid Amount Reimbursed])/SUM([2024 Population])' />
      </column>
